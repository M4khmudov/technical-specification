# Скопируйте в .env и при необходимости поменяйте значения.
# Секретов в репозитории нет: .env в .gitignore.

POSTGRES_USER=candles
POSTGRES_PASSWORD=candles
POSTGRES_DB=candles

# Часовой пояс мастерской: от него считаются «сегодня», «на этой неделе», «в пятницу»
TIMEZONE=Europe/Moscow

# OpenAI: ключ выдаётся вместе с заданием
OPENAI_API_KEY=
# Бесплатная альтернатива для проверки без ключа OpenAI — Groq (https://console.groq.com):
# GROQ_API_KEY=gsk_...
# LLM_PRIMARY=groq:openai/gpt-oss-120b
# LLM_FALLBACK=groq:openai/gpt-oss-20b
# У Groq есть выполнение кода, но нет файлов Code Interpreter: графики и выгрузки — только с OpenAI.
GROQ_API_KEY=

# Модели в формате «провайдер:модель»: основная и запасная
LLM_PRIMARY=openai:gpt-4.1
LLM_FALLBACK=openai:gpt-4.1-mini
# Таймауты: ожидание очередного куска ответа и весь ответ, секунды
LLM_EVENT_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=120

# Секрет подписи токенов, не короче 32 символов:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Пусто — бэкенд сгенерирует случайный при запуске (после перезапуска нужно войти заново)
JWT_SECRET=
