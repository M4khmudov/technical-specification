# Скопируйте в .env и при необходимости поменяйте значения.
# Секретов в репозитории нет: .env в .gitignore.

POSTGRES_USER=candles
POSTGRES_PASSWORD=candles
POSTGRES_DB=candles

# OpenAI: ключ выдаётся вместе с заданием
OPENAI_API_KEY=
# Модели в формате «провайдер:модель»: основная и запасная
LLM_PRIMARY=openai:gpt-4.1
LLM_FALLBACK=openai:gpt-4.1-mini
# Таймауты: ожидание очередного куска ответа и весь ответ, секунды
LLM_EVENT_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=120

# Не короче 32 символов, например: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
